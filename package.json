{
  "name": "purinat-life-os",
  "private": true,
  "version": "0.1.0",
  "description": "PURINAT LIFE OS: SPEAKLOG (English training log) and MILES (travel log). Static site for GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:dist": "node scripts/check-dist.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "validate:data": "node scripts/validate-data.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "images": "node scripts/optimize-images.ts",
    "check": "npm run lint && npm run type-check && npm run validate:data && npm test && npm run build && npm run check:dist"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "maplibre-gl": "6.15.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.2",
    "eslint": "9.39.4",
    "globals": "16.5.0",
    "sharp": "0.34.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.39.0",
    "vite": "7.3.5"
  }
}
