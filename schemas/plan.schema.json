{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plan.schema.json",
  "title": "SPEAKLOG Training Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next_trip",
        "phases",
        "weekly_goals",
        "weekly_template"
      ],
      "properties": {
        "next_trip": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "tentative"
          ],
          "properties": {
            "name": {
              "$ref": "common.schema.json#/$defs/shortText"
            },
            "dream_id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "start_date": {
              "$ref": "common.schema.json#/$defs/isoDate"
            },
            "target_month": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            },
            "tentative": {
              "type": "boolean"
            }
          }
        },
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "is_default",
            "items"
          ],
          "properties": {
            "is_default": {
              "type": "boolean"
            },
            "items": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "weeks",
                  "focus"
                ],
                "properties": {
                  "name": {
                    "enum": [
                      "Base",
                      "Build",
                      "Trip-Specific",
                      "Peak",
                      "Taper"
                    ]
                  },
                  "weeks": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 52
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "focus": {
                    "$ref": "common.schema.json#/$defs/text"
                  }
                }
              }
            }
          }
        },
        "weekly_goals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "is_default",
            "minutes",
            "speaking_sessions",
            "listening_minutes",
            "new_phrases"
          ],
          "properties": {
            "is_default": {
              "type": "boolean"
            },
            "minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3000
            },
            "speaking_sessions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 50
            },
            "listening_minutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3000
            },
            "new_phrases": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            }
          }
        },
        "weekly_template": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "is_default",
            "days"
          ],
          "properties": {
            "is_default": {
              "type": "boolean"
            },
            "days": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "day",
                  "activity",
                  "minutes",
                  "note"
                ],
                "properties": {
                  "day": {
                    "enum": [
                      "Mon",
                      "Tue",
                      "Wed",
                      "Thu",
                      "Fri",
                      "Sat",
                      "Sun"
                    ]
                  },
                  "activity": {
                    "enum": [
                      "speaking",
                      "listening",
                      "movie",
                      "reading",
                      "shadowing",
                      "travel-simulation",
                      "storytelling",
                      "rest"
                    ]
                  },
                  "minutes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 600
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 200
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
